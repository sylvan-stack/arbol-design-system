{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@arbol/design-system": ["heritage/renderer/packages/design-system/src/index.ts"],
      "@arbol/events": ["heritage/renderer/packages/events/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", ".storybook/**/*.ts"],
  "exclude": ["node_modules", "heritage", "storybook-static", "src/stories/legacy-*.stories.ts"]
}
