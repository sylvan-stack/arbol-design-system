{
  "name": "@sylvan-stack/arbol-design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Arbol's portable design system: components, sections, pages and preserved design evidence.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "storybook": "storybook dev -p 6006 --no-open",
    "build": "storybook build",
    "check": "svelte-check --config ./svelte.config.js --tsconfig ./tsconfig.json",
    "test": "node scripts/test-all.mjs",
    "test:coverage": "node scripts/verify-catalog.mjs",
    "test:browser": "node scripts/test-storybook.mjs",
    "preview": "node scripts/serve.mjs",
    "format": "prettier --write \"src/**/*.{ts,svelte,css,json}\" .storybook scripts *.json *.ts *.js",
    "test:interactions": "node scripts/check-interactions.mjs",
    "test:themes": "node scripts/check-themes.mjs"
  },
  "dependencies": {
    "@fontsource/hanken-grotesk": "5.3.0",
    "@fontsource/spline-sans-mono": "5.3.0",
    "svelte": "5.56.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@storybook/addon-a11y": "10.4.2",
    "@storybook/addon-docs": "10.4.2",
    "@storybook/svelte-vite": "10.4.2",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "22.19.0",
    "playwright": "1.60.0",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "storybook": "10.4.2",
    "svelte-check": "4.7.1",
    "typescript": "5.6.3",
    "vite": "8.3.2"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
